# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Lemon Squeezy Payment Gateway (https://app.lemonsqueezy.com)
# Configure these values in AI Studio Secrets (never commit real keys).
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_DEFAULT_VARIANT_ID=""
# Optional JSON map of courseId -> Lemon Squeezy variantId, e.g. {"excel-basico-05":"123456"}
LEMONSQUEEZY_VARIANT_MAP=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_TEST_MODE="false"
LEMONSQUEEZY_STORE_CURRENCY="USD"
LEMONSQUEEZY_DOP_PER_USD="60"


# DBACADEMY — Supabase (CLIENTE). Seguras para el navegador, se exponen al bundle.
VITE_SUPABASE_URL=
# Esquema nuevo (recomendado): sb_publishable_...  → usar VITE_ prefix
VITE_SUPABASE_PUBLISHABLE_KEY=
# Esquema legacy (alternativa): anon key
VITE_SUPABASE_ANON_KEY=

# DBACADEMY — Supabase (SERVIDOR). SOLO backend: nunca las prefijes con VITE_.
# Requeridas por server.ts para escrituras de administrador (guardar cursos, cupones, etc.).
# Usa SUPABASE_SECRET_KEY (sb_secret_...) o, si es legacy, SUPABASE_SERVICE_KEY.
# La clave de servicio omite RLS: secretos del hosting / .env.local, NUNCA en el frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_KEY=   # legacy, alternativa a SUPABASE_SECRET_KEY
# SUPABASE_JWKS_URL=      # opcional; la app verifica tokens con Firebase/Google, no la usa todavía

# Notificaciones por correo cuando se inscribe un alumno nuevo (SOLO servidor)
# Destinatario por defecto si no se define: marinodavidr7@gmail.com
ADMIN_NOTIFICATION_EMAIL=
# Opción 1 (API HTTPS Resend): https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opción 2 (SMTP, compatible con Gmail + Contraseña de aplicación: smtp.gmail.com / 465)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# PayPal
VITE_PAYPAL_CLIENT_ID=
# Server-side PayPal verification (required for real paid checkouts)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
