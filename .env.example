# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Lemon Squeezy Payment Gateway (https://app.lemonsqueezy.com)
# Configure these values in AI Studio Secrets (never commit real keys).
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_DEFAULT_VARIANT_ID=""
# Optional JSON map of courseId -> Lemon Squeezy variantId, e.g. {"excel-basico-05":"123456"}
LEMONSQUEEZY_VARIANT_MAP=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_TEST_MODE="false"
LEMONSQUEEZY_STORE_CURRENCY="USD"
LEMONSQUEEZY_DOP_PER_USD="60"

